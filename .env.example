# cn-devices — environment. Installed by Kauket (kaiser.cn_devices_env, 0600);
# never edit the installed file in place. Comments stay on their own lines.

# Container timezone (cron schedules, backup names)
TIMEZONE=America/New_York

# pfSense relay for Wake-on-LAN on subnets kaiser is not attached to
# (bin/wake runs /usr/local/bin/wol over SSH with /keys/pfsense).
PFSENSE_HOST=10.1.0.1
PFSENSE_SSH_USER=devices

# PocketBase superuser (break-glass; also used by setup.sh and seed.py).
# Kauket record: kaiser.cn_devices_superuser
UPSNAP_SUPERUSER_EMAIL=
UPSNAP_SUPERUSER_PASSWORD=

# Authentik OIDC client printed by cn-authentik/setup-devices-oidc.sh
# (Kauket record: kaiser.cn_devices_oidc). seed.py configure writes it
# into PocketBase's users collection as the "oidc" provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BASE_URL=https://auth.lab.gn.al/application/o

# The operator's e-mail: pre-created as a verified UpSnap user so the first
# OIDC login links to it; seed.py grants it every device permission.
OPERATOR_EMAIL=gonzaloab@gmail.com

# offen backup targets — same values as the other kaiser stacks
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2
BACKUP_WEBDAV_URL=http://10.120.26.20:5005/cloudlabbackup
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
